import java.util.*;
import java.lang.*;
import java.io.*;

class LeaderNumber
{
	public static void main (String[] args) throws java.lang.Exception
	{
	  int a[]  ={16,17,4,3,5,2};
	  int length=a.length;
	  int maxRight=a[length-1];
	  System.out.println(maxRight);
	  
	  for(int index=length-2;index>=0;index--){
	      if(a[index]>maxRight){
	          maxRight=a[index];
	          System.out.println(maxRight);
	      }
	  }
	}
}
