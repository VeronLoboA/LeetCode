import java.util.*;
import java.lang.*;
import java.io.*;

class NUMBERREVERSE
{
	public static void main (String[] args) throws java.lang.Exception
	{
	   int a=543;
	   int reverse = 0;
	   while(a!=0)
	   {
	       int digit = a%10; //3
	       reverse = digit+reverse*10;
	       a=a/10;
	   }
	   System.out.println(reverse);
	}
}
