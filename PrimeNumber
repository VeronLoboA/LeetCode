import java.util.*;
import java.lang.*;
import java.io.*;

class PrimeNumber
{
	public static void main (String[] args) throws java.lang.Exception
	{
	Boolean flag=false;
	int val=30;
	
	for(int i=2;i<31%2;i++){
	    if(val/i==0){
	        flag=true;
	        break;
	    }
	}
	if(flag)
	System.out.println("it is not prime");
	else
	System.out.println("it is prime");

	}
}
