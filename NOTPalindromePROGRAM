import java.util.*;
import java.lang.*;
import java.io.*;

class NOTpalindrome
{
	public static void main (String[] args) throws java.lang.Exception
	{
	   String a ="mada";
	   String t="";
	   for(int i=a.length()-1;i>=0;i--){
	      t=t+a.charAt(i);
	   }
	   if(a.equals(t)){
	       System.out.println("palindrome");
	    }else {
	       System.out.println("not");
	   }
	}
}
