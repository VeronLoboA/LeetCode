import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		int[] arr={1,2,3,5};
		
		int n=5;
		int sum=n*(n+1)/2;
		int actual =0;
		
		for(int num:arr)
		actual +=num;
		
		System.out.println(sum-actual);
		
		
		    
		
	}
}
