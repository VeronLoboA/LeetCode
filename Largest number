import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		
		int[] arr ={1,2,2,2,3,4};
		
		int max =arr[0];
		
		for(int i=0;i<arr.length;i++){
		    if(arr[i]>max){
		        max=arr[i];
		    }
		    
		}
		System.out.println(max);
		
		    
		
	}
}
