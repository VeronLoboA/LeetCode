import java.util.*;
import java.lang.*;
import java.io.*;

class MissingNumberinArray
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    int arr[]={1, 2, 3, 4, 5, 7, 8, 9, 10 };
	    int sum1=0;
	    
	    for(int i=0;i<arr.length;i++){
	        sum1=sum1+arr[i];
	    }
	    int sum2=0;
	    for(int j=1;j<=10;j++){
	        sum2=sum2+j;
	    }
	    System.out.println(sum2-sum1);
	}
}
