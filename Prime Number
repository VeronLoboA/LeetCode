import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static boolean isPrime(int n){
	    if(n<=1){
	        return false;
	    }else{
	        for(int i =2;i<n;i++){
	            if(n%i==0){
	                return false;
	            }
	        }
	    }
	    return true;
	}
	public static void main(String[]args){
	    if(isPrime(4)){
	        System.out.println("Prime");
	        
	    }else{
	        System.out.println("Not Prime");
	    }
	}
}
