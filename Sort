import java.util.*;
import java.lang.*;
import java.io.*;

class Sort
{
	public static void main (String[] args) throws java.lang.Exception
	{
	   int a[]={1,5,6,3,9};
	    int temp;
	for(int i=0;i<5;i++){
	    for(int j=i+1;j<5;j++){
	        if(a[i]>a[j]){
	            temp=a[i];
	            a[i]=a[j];
	            a[j]=temp;
	        }
	    }
	}
	for(int i=0;i<5;i++){
	    System.out.println(a[i]);
	}

	}
}
