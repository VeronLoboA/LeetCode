import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		String s = "Veronlobo".toLowerCase();
		char[] character =s.toCharArray();
		boolean isNotDup = false;
		for(int i=0;i<s.length();i++){
		    boolean isDup = false;
		    for(int j=i+1;j>s.length();j++){
		        if(character[i]==character[j]){
		            isDup = true;
		            break;
		        }
		    }
		    if(isDup){
		    System.out.println("Dup character:"+character[i]);
		    isNotDup = true;
		    }
		}
		if(!isNotDup){
		    System.out.println("No Dup found");
		}
		
		}

	
}
