import java.util.*;
import java.lang.*;
import java.io.*;

class Pyramid
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
	
		
		for(int i=1;i<5;i++){
		    for(int j=1;j<=i;j++){
		        System.out.print("*");
		        System.out.print("\t");
		    }
		    System.out.println();
		}

	}
}
