import java.util.*;
import java.lang.*;
import java.io.*;

class LengthofLastword
{
	public static void main (String[] args) throws java.lang.Exception
	{
		String s="Veron Lobo";
		char [] input= s.toCharArray();
		int count =0;
		for(int i=s.length()-1;i>=0;i--){
		    if(input[i] !=' '){
		        count++;
		    }else{
		        break;
		    }
		}
		System.out.println(count);
		

	}
}
