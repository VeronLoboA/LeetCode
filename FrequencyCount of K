import java.util.*;
import java.lang.*;
import java.io.*;

class FrequencyCount {
    public static void main(String[] args){
        int[]a ={1,1,2,2,2,3,4};
        int k=2;
        int count =0;
        
        for(int i=0;i< a.length;i++){
            if(a[i]==k){
                count++;
            }
        }
        System.out.println("Frequency of"+ k + " is " + count);
        
    }
}
