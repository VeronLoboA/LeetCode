import java.util.*;
import java.lang.*;
import java.io.*;
import java.util.*;

public class Main{
    public static List<Character> orderofOccurrence(String s){
        Set<Character> seen = new HashSet<>();
        List<Character> order = new ArrayList<>();
        for(char ch:s.toCharArray()){
            if(!seen.contains(ch)){
                seen.add(ch);
                order.add(ch);
            }
        }
        return order;
    }
    public static void main(String[] args){
     String s = "abracadabra";
     List<Character> result = orderofOccurrence(s);
System.out.println(result);
    }
}
