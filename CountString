import java.util.*;
import java.lang.*;
import java.io.*;

class CountString
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    String name="Sandhiya Vinayagamoorthy";
	    int count=0;
	    for(int i=0;i<name.length();i++){
	        if(name.charAt(i)!=' '){
	            count++;
	        }
	    }
	    System.out.println(count);
	
	}
}
