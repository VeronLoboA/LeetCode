import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		int arr[]={1,1,2,2,2,3};
		
		HashMap<Integer,Integer> map = new HashMap<>();
		
		for(int num:arr){
		    map.put(num,map.getOrDefault(num,0)+1);
		}
		System.out.println(map);

	}
}
