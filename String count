import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		String a = "This is a string";
		int count= 0;
		for(int i=0;i<a.length();i++){
		    if(a.charAt(i) != ' '){
		        count++;
		    }
		}
		System.out.println(count);
	}
}
