import java.util.*;
import java.lang.*;
import java.io.*;

class DuplicatesinArray
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    int a[]={1,4,5,7,8,1};
	    HashSet<Integer> set = new HashSet<Integer>();
	    for(int num:a){
	        if(!set.add(num)){
	            System.out.println(num);
	        }
	    }
	}
}
